# Primary provider: Amazon Bedrock (Claude 3 Sonnet)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# Fallback provider: self-managed OpenAI-compatible endpoint (Meta-Llama / Qwen)
FALLBACK_BASE_URL=http://your-intel-server-or-llm-host:8001
FALLBACK_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
FALLBACK_API_KEY=

# Optional tertiary fallback
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Performance / logging
LLM_TIMEOUT_SECONDS=30
LLM_CACHE_TTL_SECONDS=300
LLM_CACHE_MAX=128
AUDIT_LOG_PATH=audit.log
LOG_LEVEL=INFO
