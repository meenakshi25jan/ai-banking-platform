<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_student_academic_year_tree" model="ir.ui.view">
    <field name="name">student.academic.year.tree</field>
    <field name="model">student.academic.year</field>
    <field name="arch" type="xml">
      <tree>
        <field name="code"/>
        <field name="name"/>
        <field name="date_start"/>
        <field name="date_end"/>
        <field name="current"/>
      </tree>
    </field>
  </record>

  <record id="view_student_academic_year_form" model="ir.ui.view">
    <field name="name">student.academic.year.form</field>
    <field name="model">student.academic.year</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="code"/>
            </group>
            <group>
              <field name="date_start"/>
              <field name="date_end"/>
              <field name="current"/>
              <field name="active"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_student_academic_year" model="ir.actions.act_window">
    <field name="name">Academic Years</field>
    <field name="res_model">student.academic.year</field>
    <field name="view_mode">tree,form</field>
  </record>
</odoo>
