<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_student_program_tree" model="ir.ui.view">
    <field name="name">student.program.tree</field>
    <field name="model">student.program</field>
    <field name="arch" type="xml">
      <tree>
        <field name="code"/>
        <field name="name"/>
        <field name="department_id"/>
        <field name="campus_id"/>
        <field name="duration_years"/>
      </tree>
    </field>
  </record>

  <record id="view_student_program_form" model="ir.ui.view">
    <field name="name">student.program.form</field>
    <field name="model">student.program</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="code"/>
              <field name="department_id"/>
            </group>
            <group>
              <field name="campus_id"/>
              <field name="duration_years"/>
              <field name="active"/>
            </group>
          </group>
          <field name="description"/>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_student_program" model="ir.actions.act_window">
    <field name="name">Programs</field>
    <field name="res_model">student.program</field>
    <field name="view_mode">tree,form</field>
  </record>
</odoo>
