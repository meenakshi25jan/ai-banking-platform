<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_student_campus_tree" model="ir.ui.view">
    <field name="name">student.campus.tree</field>
    <field name="model">student.campus</field>
    <field name="arch" type="xml">
      <tree>
        <field name="code"/>
        <field name="name"/>
        <field name="city"/>
        <field name="phone"/>
        <field name="email"/>
        <field name="department_count"/>
      </tree>
    </field>
  </record>

  <record id="view_student_campus_form" model="ir.ui.view">
    <field name="name">student.campus.form</field>
    <field name="model">student.campus</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_title">
            <h1><field name="name" placeholder="Campus Name"/></h1>
          </div>
          <group>
            <group>
              <field name="code"/>
              <field name="phone"/>
              <field name="email"/>
            </group>
            <group>
              <field name="city"/>
              <field name="state_id"/>
              <field name="country_id"/>
              <field name="zip"/>
            </group>
          </group>
          <group>
            <field name="address"/>
          </group>
          <notebook>
            <page string="Departments">
              <field name="department_ids">
                <tree editable="bottom">
                  <field name="code"/>
                  <field name="name"/>
                  <field name="head_id"/>
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="action_student_campus" model="ir.actions.act_window">
    <field name="name">Campuses</field>
    <field name="res_model">student.campus</field>
    <field name="view_mode">tree,form</field>
  </record>
</odoo>
