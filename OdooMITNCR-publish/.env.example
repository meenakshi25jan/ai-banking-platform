# --- student-admission-portal-vercel (Vercel) ---
NEXT_PUBLIC_ODOO_URL=http://localhost:8069
NEXT_PUBLIC_ODOO_DB=student_admission

# --- student-admission-odoo-backend (Docker / Railway / VPS) ---
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo
POSTGRES_DB=postgres
ODOO_DATABASE=student_admission
ODOO_DB_USER=odoo
STUDENT_ADMISSION_CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# --- server (Express / MongoDB API) ---
PORT=5000
MONGODB_URI=mongodb://localhost:27017/ai-banking
JWT_SECRET=change-me-in-production
AI_SERVICE_URL=http://localhost:8000
BASE_URL=http://localhost:5000
