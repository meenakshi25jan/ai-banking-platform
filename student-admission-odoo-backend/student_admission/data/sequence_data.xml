<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="seq_student_registration" model="ir.sequence">
    <field name="name">Student Registration</field>
    <field name="code">student.registration</field>
    <field name="prefix">REG/%(year)s/</field>
    <field name="padding">5</field>
    <field name="company_id" eval="False"/>
  </record>

  <record id="seq_student_admission" model="ir.sequence">
    <field name="name">Student Admission</field>
    <field name="code">student.admission</field>
    <field name="prefix">ADM/%(year)s/</field>
    <field name="padding">5</field>
    <field name="company_id" eval="False"/>
  </record>

  <record id="seq_student_fee_receipt" model="ir.sequence">
    <field name="name">Fee Receipt</field>
    <field name="code">student.fee.receipt</field>
    <field name="prefix">RCPT/%(year)s/</field>
    <field name="padding">5</field>
    <field name="company_id" eval="False"/>
  </record>
</odoo>
