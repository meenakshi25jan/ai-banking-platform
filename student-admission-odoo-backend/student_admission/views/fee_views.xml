<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_student_fee_payment_tree" model="ir.ui.view">
    <field name="name">student.fee.payment.tree</field>
    <field name="model">student.fee.payment</field>
    <field name="arch" type="xml">
      <tree decoration-danger="state == 'pending'" decoration-success="state == 'paid'">
        <field name="name"/>
        <field name="admission_id"/>
        <field name="student_name"/>
        <field name="course_id"/>
        <field name="fee_type"/>
        <field name="amount"/>
        <field name="due_date"/>
        <field name="payment_date"/>
        <field name="state" widget="badge"/>
      </tree>
    </field>
  </record>

  <record id="view_student_fee_payment_form" model="ir.ui.view">
    <field name="name">student.fee.payment.form</field>
    <field name="model">student.fee.payment</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_register_payment" string="Register Payment" type="object"
            class="oe_highlight" invisible="state != 'pending'"/>
          <button name="action_cancel" string="Cancel" type="object"
            invisible="state != 'pending'"/>
          <button name="action_reset_pending" string="Reset to Pending" type="object"
            invisible="state != 'paid'"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="name" readonly="1"/></h1>
          </div>
          <group>
            <group>
              <field name="admission_id"/>
              <field name="student_name"/>
              <field name="course_id"/>
              <field name="fee_type"/>
              <field name="currency_id" invisible="1"/>
              <field name="amount"/>
            </group>
            <group>
              <field name="due_date"/>
              <field name="payment_date"/>
              <field name="payment_method"/>
              <field name="reference"/>
            </group>
          </group>
          <field name="notes"/>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_student_fee_payment_search" model="ir.ui.view">
    <field name="name">student.fee.payment.search</field>
    <field name="model">student.fee.payment</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="student_name"/>
        <field name="admission_id"/>
        <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]"/>
        <filter string="Paid" name="paid" domain="[('state', '=', 'paid')]"/>
        <group expand="0" string="Group By">
          <filter string="Fee Type" name="group_fee_type" context="{'group_by': 'fee_type'}"/>
          <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
          <filter string="Course" name="group_course" context="{'group_by': 'course_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="view_student_fee_payment_graph" model="ir.ui.view">
    <field name="name">student.fee.payment.graph</field>
    <field name="model">student.fee.payment</field>
    <field name="arch" type="xml">
      <graph type="bar">
        <field name="fee_type"/>
        <field name="amount" type="measure"/>
      </graph>
    </field>
  </record>

  <record id="action_student_fee_payment" model="ir.actions.act_window">
    <field name="name">Fee Payments</field>
    <field name="res_model">student.fee.payment</field>
    <field name="view_mode">tree,form,graph</field>
  </record>

  <record id="action_student_fee_pending" model="ir.actions.act_window">
    <field name="name">Pending Fees</field>
    <field name="res_model">student.fee.payment</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[('state', '=', 'pending')]</field>
  </record>
</odoo>
