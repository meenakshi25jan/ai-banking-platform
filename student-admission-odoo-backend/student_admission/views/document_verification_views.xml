<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_document_checklist_tree" model="ir.ui.view">
    <field name="name">student.document.checklist.tree</field>
    <field name="model">student.document.checklist</field>
    <field name="arch" type="xml">
      <tree>
        <field name="sequence" widget="handle"/>
        <field name="code"/>
        <field name="name"/>
        <field name="required"/>
        <field name="active"/>
      </tree>
    </field>
  </record>

  <record id="view_document_checklist_form" model="ir.ui.view">
    <field name="name">student.document.checklist.form</field>
    <field name="model">student.document.checklist</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="code"/>
            <field name="sequence"/>
            <field name="required"/>
            <field name="active"/>
          </group>
          <field name="description"/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_document_verification_tree" model="ir.ui.view">
    <field name="name">student.document.verification.tree</field>
    <field name="model">student.document.verification</field>
    <field name="arch" type="xml">
      <tree decoration-danger="state == 'rejected'" decoration-success="state == 'approved'">
        <field name="admission_id"/>
        <field name="student_name"/>
        <field name="name"/>
        <field name="required"/>
        <field name="state" widget="badge"/>
        <field name="verified_by"/>
        <field name="verification_date"/>
      </tree>
    </field>
  </record>

  <record id="view_document_verification_form" model="ir.ui.view">
    <field name="name">student.document.verification.form</field>
    <field name="model">student.document.verification</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_submit_document" string="Submit Document" type="object"
            invisible="state != 'pending'"/>
          <button name="action_approve" string="Approve" type="object" class="oe_highlight"
            invisible="state != 'submitted'"/>
          <button name="action_reject" string="Reject" type="object"
            invisible="state not in ('submitted', 'pending')"/>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="admission_id"/>
              <field name="student_name"/>
              <field name="name"/>
              <field name="checklist_id"/>
              <field name="required"/>
            </group>
            <group>
              <field name="document_file" filename="document_filename"/>
              <field name="document_filename" invisible="1"/>
              <field name="verified_by"/>
              <field name="verification_date"/>
            </group>
          </group>
          <field name="remarks"/>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_document_verification_search" model="ir.ui.view">
    <field name="name">student.document.verification.search</field>
    <field name="model">student.document.verification</field>
    <field name="arch" type="xml">
      <search>
        <field name="admission_id"/>
        <field name="student_name"/>
        <field name="name"/>
        <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]"/>
        <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
        <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
        <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
      </search>
    </field>
  </record>

  <record id="action_document_checklist" model="ir.actions.act_window">
    <field name="name">Document Checklist</field>
    <field name="res_model">student.document.checklist</field>
    <field name="view_mode">tree,form</field>
  </record>

  <record id="action_document_verification" model="ir.actions.act_window">
    <field name="name">Document Verifications</field>
    <field name="res_model">student.document.verification</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'search_default_pending': 1}</field>
  </record>
</odoo>
