<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_student_registration_tree" model="ir.ui.view">
    <field name="name">student.registration.tree</field>
    <field name="model">student.registration</field>
    <field name="arch" type="xml">
      <tree decoration-muted="state == 'cancelled'" decoration-success="state == 'registered'">
        <field name="name"/>
        <field name="full_name"/>
        <field name="email"/>
        <field name="mobile"/>
        <field name="date_of_birth"/>
        <field name="gender"/>
        <field name="state" widget="badge"
          decoration-info="state == 'draft'"
          decoration-success="state == 'registered'"
          decoration-danger="state == 'cancelled'"/>
        <field name="admission_count"/>
      </tree>
    </field>
  </record>

  <record id="view_student_registration_form" model="ir.ui.view">
    <field name="name">student.registration.form</field>
    <field name="model">student.registration</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_register" string="Confirm Registration" type="object"
            class="oe_highlight" invisible="state != 'draft'"/>
          <button name="action_create_admission" string="Create Admission" type="object"
            invisible="state != 'registered'"/>
          <button name="action_cancel" string="Cancel" type="object"
            invisible="state != 'registered'"/>
          <button name="action_reset_draft" string="Reset to Draft" type="object"
            invisible="state == 'draft'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,registered"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="name" readonly="1"/></h1>
          </div>
          <group>
            <group string="Personal Information">
              <field name="first_name"/>
              <field name="last_name"/>
              <field name="full_name" invisible="1"/>
              <field name="date_of_birth"/>
              <field name="gender"/>
              <field name="aadhaar_number"/>
              <field name="photograph" filename="photograph_filename"/>
              <field name="photograph_filename" invisible="1"/>
            </group>
            <group string="Contact Details">
              <field name="email"/>
              <field name="mobile"/>
              <field name="address"/>
              <field name="city"/>
              <field name="state_id"/>
              <field name="country_id"/>
              <field name="zip"/>
            </group>
          </group>
          <group string="Parent/Guardian Details">
            <group>
              <field name="parent_name"/>
              <field name="parent_relation"/>
            </group>
            <group>
              <field name="parent_mobile"/>
              <field name="parent_email"/>
            </group>
          </group>
          <notebook>
            <page string="Supporting Documents">
              <field name="document_ids">
                <tree editable="bottom">
                  <field name="name"/>
                  <field name="document_type"/>
                  <field name="file" filename="filename"/>
                  <field name="filename" invisible="1"/>
                  <field name="description"/>
                </tree>
              </field>
            </page>
            <page string="Admission Applications">
              <field name="admission_ids" readonly="1">
                <tree>
                  <field name="name"/>
                  <field name="course_id"/>
                  <field name="academic_year_id"/>
                  <field name="state"/>
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_student_registration_search" model="ir.ui.view">
    <field name="name">student.registration.search</field>
    <field name="model">student.registration</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="full_name"/>
        <field name="email"/>
        <field name="mobile"/>
        <field name="aadhaar_number"/>
        <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
        <filter string="Registered" name="registered" domain="[('state', '=', 'registered')]"/>
        <group expand="0" string="Group By">
          <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
          <filter string="Gender" name="group_gender" context="{'group_by': 'gender'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_student_registration" model="ir.actions.act_window">
    <field name="name">Student Registrations</field>
    <field name="res_model">student.registration</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'search_default_registered': 0}</field>
  </record>
</odoo>
