<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_student_course_tree" model="ir.ui.view">
    <field name="name">student.course.tree</field>
    <field name="model">student.course</field>
    <field name="arch" type="xml">
      <tree>
        <field name="code"/>
        <field name="name"/>
        <field name="program_id"/>
        <field name="department_id"/>
        <field name="total_seats"/>
        <field name="available_seats"/>
        <field name="admission_fee"/>
        <field name="course_fee"/>
      </tree>
    </field>
  </record>

  <record id="view_student_course_form" model="ir.ui.view">
    <field name="name">student.course.form</field>
    <field name="model">student.course</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="code"/>
              <field name="program_id"/>
              <field name="department_id"/>
              <field name="campus_id"/>
            </group>
            <group>
              <field name="duration_months"/>
              <field name="total_seats"/>
              <field name="available_seats"/>
              <field name="currency_id" invisible="1"/>
              <field name="admission_fee"/>
              <field name="course_fee"/>
              <field name="active"/>
            </group>
          </group>
          <group>
            <field name="eligibility_criteria"/>
            <field name="description"/>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_student_course_search" model="ir.ui.view">
    <field name="name">student.course.search</field>
    <field name="model">student.course</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="code"/>
        <field name="department_id"/>
        <filter string="Available Seats" name="available" domain="[('available_seats', '>', 0)]"/>
      </search>
    </field>
  </record>

  <record id="action_student_course" model="ir.actions.act_window">
    <field name="name">Courses</field>
    <field name="res_model">student.course</field>
    <field name="view_mode">tree,form</field>
  </record>
</odoo>
