<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_student_admission_tree" model="ir.ui.view">
    <field name="name">student.admission.application.tree</field>
    <field name="model">student.admission.application</field>
    <field name="arch" type="xml">
      <tree decoration-success="state == 'admitted'" decoration-danger="state == 'rejected'">
        <field name="name"/>
        <field name="full_name"/>
        <field name="course_id"/>
        <field name="department_id"/>
        <field name="academic_year_id"/>
        <field name="application_date"/>
        <field name="state" widget="badge"
          decoration-info="state in ('draft', 'submitted')"
          decoration-warning="state == 'under_review'"
          decoration-success="state in ('approved', 'admitted')"
          decoration-danger="state == 'rejected'"/>
        <field name="pending_fee"/>
      </tree>
    </field>
  </record>

  <record id="view_student_admission_form" model="ir.ui.view">
    <field name="name">student.admission.application.form</field>
    <field name="model">student.admission.application</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_submit" string="Submit" type="object" class="oe_highlight"
            invisible="state != 'draft'"/>
          <button name="action_under_review" string="Under Review" type="object"
            invisible="state != 'submitted'"/>
          <button name="action_approve" string="Approve" type="object" class="oe_highlight"
            invisible="state not in ('submitted', 'under_review')"/>
          <button name="action_reject" string="Reject" type="object"
            invisible="state not in ('submitted', 'under_review', 'approved')"/>
          <button name="action_admit" string="Admit Student" type="object" class="oe_highlight"
            invisible="state != 'approved'"/>
          <button name="action_reset_draft" string="Reset to Draft" type="object"
            invisible="state == 'draft'"/>
          <field name="state" widget="statusbar"
            statusbar_visible="draft,submitted,under_review,approved,admitted"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="name" readonly="1"/></h1>
          </div>
          <group>
            <group>
              <field name="registration_id"/>
              <field name="full_name"/>
              <field name="email"/>
              <field name="mobile"/>
              <field name="application_date"/>
            </group>
            <group>
              <field name="academic_year_id"/>
              <field name="course_id"/>
              <field name="program_id"/>
              <field name="department_id"/>
              <field name="campus_id"/>
              <field name="batch_id"/>
              <field name="semester_id"/>
            </group>
          </group>
          <group>
            <group>
              <field name="verification_progress" widget="progressbar"/>
              <field name="all_documents_verified"/>
            </group>
            <group>
              <field name="currency_id" invisible="1"/>
              <field name="total_fee"/>
              <field name="paid_fee"/>
              <field name="pending_fee"/>
            </group>
          </group>
          <field name="rejection_reason" invisible="state != 'rejected'"/>
          <notebook>
            <page string="Document Verification">
              <field name="document_verification_ids">
                <tree editable="bottom">
                  <field name="name"/>
                  <field name="required"/>
                  <field name="document_file" filename="document_filename"/>
                  <field name="document_filename" invisible="1"/>
                  <field name="state" widget="badge"/>
                  <field name="verified_by"/>
                  <field name="verification_date"/>
                  <field name="remarks"/>
                  <button name="action_submit_document" string="Submit" type="object"
                    invisible="state != 'pending'"/>
                  <button name="action_approve" string="Approve" type="object"
                    invisible="state != 'submitted'"/>
                  <button name="action_reject" string="Reject" type="object"
                    invisible="state not in ('submitted', 'pending')"/>
                </tree>
              </field>
            </page>
            <page string="Fee Payments">
              <field name="fee_ids">
                <tree>
                  <field name="name"/>
                  <field name="fee_type"/>
                  <field name="amount"/>
                  <field name="due_date"/>
                  <field name="payment_date"/>
                  <field name="state" widget="badge"/>
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_student_admission_search" model="ir.ui.view">
    <field name="name">student.admission.application.search</field>
    <field name="model">student.admission.application</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="full_name"/>
        <field name="course_id"/>
        <field name="department_id"/>
        <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
        <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
        <filter string="Under Review" name="under_review" domain="[('state', '=', 'under_review')]"/>
        <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
        <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
        <filter string="Admitted" name="admitted" domain="[('state', '=', 'admitted')]"/>
        <group expand="0" string="Group By">
          <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
          <filter string="Course" name="group_course" context="{'group_by': 'course_id'}"/>
          <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="view_student_admission_graph" model="ir.ui.view">
    <field name="name">student.admission.application.graph</field>
    <field name="model">student.admission.application</field>
    <field name="arch" type="xml">
      <graph type="bar" stacked="False">
        <field name="course_id"/>
        <field name="state" type="row"/>
      </graph>
    </field>
  </record>

  <record id="view_student_admission_pivot" model="ir.ui.view">
    <field name="name">student.admission.application.pivot</field>
    <field name="model">student.admission.application</field>
    <field name="arch" type="xml">
      <pivot>
        <field name="department_id" type="row"/>
        <field name="course_id" type="col"/>
        <field name="state" type="col"/>
      </pivot>
    </field>
  </record>

  <record id="action_student_admission" model="ir.actions.act_window">
    <field name="name">Admission Applications</field>
    <field name="res_model">student.admission.application</field>
    <field name="view_mode">tree,form,graph,pivot</field>
  </record>
</odoo>
