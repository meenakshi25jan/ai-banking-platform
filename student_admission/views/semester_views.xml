<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_student_semester_tree" model="ir.ui.view">
    <field name="name">student.semester.tree</field>
    <field name="model">student.semester</field>
    <field name="arch" type="xml">
      <tree>
        <field name="sequence"/>
        <field name="code"/>
        <field name="name"/>
        <field name="program_id"/>
        <field name="academic_year_id"/>
        <field name="date_start"/>
        <field name="date_end"/>
      </tree>
    </field>
  </record>

  <record id="view_student_semester_form" model="ir.ui.view">
    <field name="name">student.semester.form</field>
    <field name="model">student.semester</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="code"/>
              <field name="sequence"/>
            </group>
            <group>
              <field name="program_id"/>
              <field name="academic_year_id"/>
              <field name="date_start"/>
              <field name="date_end"/>
              <field name="active"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_student_semester" model="ir.actions.act_window">
    <field name="name">Semesters</field>
    <field name="res_model">student.semester</field>
    <field name="view_mode">tree,form</field>
  </record>
</odoo>
