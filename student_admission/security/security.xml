<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_student_admission" model="ir.module.category">
    <field name="name">Student Admission</field>
    <field name="description">Student Registration and Admission Management</field>
    <field name="sequence">25</field>
  </record>

  <record id="group_student_super_admin" model="res.groups">
    <field name="name">Super Admin</field>
    <field name="category_id" ref="module_category_student_admission"/>
    <field name="implied_ids" eval="[(4, ref('base.group_system'))]"/>
    <field name="comment">Full system access including settings.</field>
  </record>

  <record id="group_student_academic_officer" model="res.groups">
    <field name="name">Academic Officer</field>
    <field name="category_id" ref="module_category_student_admission"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    <field name="comment">Academic structure and course management.</field>
  </record>

  <record id="group_student_parent" model="res.groups">
    <field name="name">Parent</field>
    <field name="category_id" ref="module_category_student_admission"/>
    <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    <field name="comment">Parent portal access to linked student records.</field>
  </record>

  <record id="group_student_admission_officer" model="res.groups">
    <field name="name">Admission Officer</field>
    <field name="category_id" ref="module_category_student_admission"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    <field name="comment">Registration and verification management.</field>
  </record>

  <record id="group_student_account_officer" model="res.groups">
    <field name="name">Account Officer</field>
    <field name="category_id" ref="module_category_student_admission"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    <field name="comment">Fee collection and payment management.</field>
  </record>

  <record id="group_student_portal" model="res.groups">
    <field name="name">Student</field>
    <field name="category_id" ref="module_category_student_admission"/>
    <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    <field name="comment">Portal access for students to view applications and upload documents.</field>
  </record>

  <record id="group_student_admission_admin" model="res.groups">
    <field name="name">Admission Administrator</field>
    <field name="category_id" ref="module_category_student_admission"/>
    <field name="implied_ids" eval="[
      (4, ref('base.group_user')),
      (4, ref('group_student_admission_officer')),
      (4, ref('group_student_account_officer')),
      (4, ref('group_student_academic_officer')),
    ]"/>
    <field name="comment">Full access to student admission ERP.</field>
  </record>

  <record id="rule_student_registration_portal" model="ir.rule">
    <field name="name">Student Registration: Portal User</field>
    <field name="model_id" ref="model_student_registration"/>
    <field name="domain_force">[('user_id', '=', user.id)]</field>
    <field name="groups" eval="[(4, ref('group_student_portal'))]"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="True"/>
    <field name="perm_create" eval="True"/>
    <field name="perm_unlink" eval="False"/>
  </record>

  <record id="rule_student_admission_portal" model="ir.rule">
    <field name="name">Admission Application: Portal User</field>
    <field name="model_id" ref="model_student_admission_application"/>
    <field name="domain_force">[('registration_id.user_id', '=', user.id)]</field>
    <field name="groups" eval="[(4, ref('group_student_portal'))]"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="True"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>

  <record id="rule_document_verification_portal" model="ir.rule">
    <field name="name">Document Verification: Portal User</field>
    <field name="model_id" ref="model_student_document_verification"/>
    <field name="domain_force">[('admission_id.registration_id.user_id', '=', user.id)]</field>
    <field name="groups" eval="[(4, ref('group_student_portal'))]"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="True"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>

  <record id="rule_fee_payment_portal" model="ir.rule">
    <field name="name">Fee Payment: Portal User Read Only</field>
    <field name="model_id" ref="model_student_fee_payment"/>
    <field name="domain_force">[('admission_id.registration_id.user_id', '=', user.id)]</field>
    <field name="groups" eval="[(4, ref('group_student_portal'))]"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>
</odoo>
