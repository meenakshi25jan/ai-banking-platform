<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="mail_template_registration_confirmation" model="mail.template">
    <field name="name">Registration Confirmation</field>
    <field name="model_id" ref="model_student_registration"/>
    <field name="subject">Registration Confirmed - {{ object.name }}</field>
    <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
    <field name="email_to">{{ object.email }}</field>
    <field name="body_html" type="html">
      <div>
        <p>Dear <t t-out="object.full_name"/>,</p>
        <p>Your student registration has been confirmed successfully.</p>
        <p><strong>Registration Number:</strong> <t t-out="object.name"/></p>
        <p>You may now proceed with your admission application.</p>
        <p>Regards,<br/>Admissions Office</p>
      </div>
    </field>
  </record>

  <record id="mail_template_admission_approval" model="mail.template">
    <field name="name">Admission Approval</field>
    <field name="model_id" ref="model_student_admission_application"/>
    <field name="subject">Admission Approved - {{ object.name }}</field>
    <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
    <field name="email_to">{{ object.email }}</field>
    <field name="body_html" type="html">
      <div>
        <p>Dear <t t-out="object.full_name"/>,</p>
        <p>Congratulations! Your admission application has been approved.</p>
        <p><strong>Admission Number:</strong> <t t-out="object.name"/></p>
        <p><strong>Course:</strong> <t t-out="object.course_id.name"/></p>
        <p>Please complete the fee payment to finalize your admission.</p>
        <p>Regards,<br/>Admissions Office</p>
      </div>
    </field>
  </record>

  <record id="mail_template_admission_rejection" model="mail.template">
    <field name="name">Admission Rejection</field>
    <field name="model_id" ref="model_student_admission_application"/>
    <field name="subject">Admission Application Update - {{ object.name }}</field>
    <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
    <field name="email_to">{{ object.email }}</field>
    <field name="body_html" type="html">
      <div>
        <p>Dear <t t-out="object.full_name"/>,</p>
        <p>We regret to inform you that your admission application has been rejected.</p>
        <p><strong>Admission Number:</strong> <t t-out="object.name"/></p>
        <p><strong>Reason:</strong> <t t-out="object.rejection_reason or 'Not specified'"/></p>
        <p>Regards,<br/>Admissions Office</p>
      </div>
    </field>
  </record>

  <record id="mail_template_fee_due_reminder" model="mail.template">
    <field name="name">Fee Due Reminder</field>
    <field name="model_id" ref="model_student_fee_payment"/>
    <field name="subject">Fee Payment Reminder - {{ object.name }}</field>
    <field name="email_from">{{ (object.company_id.email or user.email_formatted) }}</field>
    <field name="email_to">{{ object.admission_id.email }}</field>
    <field name="body_html" type="html">
      <div>
        <p>Dear <t t-out="object.student_name"/>,</p>
        <p>This is a reminder that your fee payment is due.</p>
        <p><strong>Receipt Number:</strong> <t t-out="object.name"/></p>
        <p><strong>Fee Type:</strong> <t t-out="object.fee_type"/></p>
        <p><strong>Amount:</strong> <t t-out="object.amount"/> <t t-out="object.currency_id.name"/></p>
        <p><strong>Due Date:</strong> <t t-out="object.due_date"/></p>
        <p>Regards,<br/>Accounts Office</p>
      </div>
    </field>
  </record>
</odoo>
